# ==========================================================
# StudyCord Next.js — Unified Full-Stack Environment Variables
# ==========================================================

# 1. MongoDB Database & Atlas Vector Search
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=studycord

# 2. NextAuth (Auth.js v5)
AUTH_SECRET=generate_with_openssl_rand_hex_32
NEXTAUTH_URL=http://localhost:3000

# Optional Google OAuth
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# 3. Pusher Channels (Free Tier Realtime)
# Sign up at pusher.com (Free tier: 200,000 msgs/day)
PUSHER_APP_ID=
PUSHER_SECRET=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=mt1

# 4. Storage — Cloudinary (Zero Credit Card Required — Free 25 GB)
# Sign up at https://cloudinary.com/users/register_free
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: Cloudflare R2 (If preferred instead of Cloudinary)
# CLOUDFLARE_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=studycord-files
# NEXT_PUBLIC_R2_PUBLIC_URL=

# 5. Metered TURN (WebRTC Voice/Video)
METERED_DOMAIN=studycord.metered.live
METERED_SECRET_KEY=

# 6. AI Providers (Embeddings & Generation)
GEMINI_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto
NVIDIA_API_KEY=
NVIDIA_MODEL=
